{
  "manifest_version": 3,
  "name": "Bookmarks Mirror",
  "version": "1.0.0",
  "description": "One-way mirror: pulls a bookmarks JSON file from a URL into the browser. Never writes back.",

  "browser_specific_settings": {
    "gecko": {
      "id": "bookmarks-mirror@dbautz.com",
      "strict_min_version": "115.0"
    }
  },

  "permissions": ["bookmarks", "storage", "alarms"],
  "optional_host_permissions": ["*://*/*"],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_title": "Sync bookmarks now"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
